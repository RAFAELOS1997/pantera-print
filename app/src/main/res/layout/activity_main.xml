<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="Pantera Print" android:textSize="28sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:text="Diagnóstico da impressora térmica" android:textSize="16sp" android:layout_marginBottom="18dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<Button android:id="@+id/scanButton" android:text="Procurar impressora" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/stopButton" android:text="Parar busca" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/status" android:text="Pronto para procurar." android:paddingTop="12dp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<LinearLayout android:id="@+id/deviceList" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="Relatório GATT" android:textStyle="bold" android:textSize="18sp" android:paddingTop="18dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:id="@+id/report" android:text="Toque em um dispositivo para conectar e descobrir serviços/UUIDs." android:textIsSelectable="true" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout></ScrollView>